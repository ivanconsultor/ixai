# ==========================================================================
# AGÊNCIA IX AI — Apache: segurança, cache e compressão
# Criado em 19/10/2026. Sobe para a raiz da public_html junto com o site.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. HTTPS e endereço único (evita conteúdo duplicado entre www e sem www)
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tudo em HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Sem www, para bater com o canonical das páginas
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# 2. Cabeçalhos de segurança
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  # O navegador respeita o Content-Type declarado, não adivinha
  Header always set X-Content-Type-Options "nosniff"

  # O site não pode ser embutido em iframe de terceiros (anti clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Só manda o domínio como referência ao sair para fora
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nenhuma API sensível do navegador é usada por este site
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

  # HSTS: só depois que o HTTPS estiver estável no domínio (2 anos, com subdomínios)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" env=HTTPS

  # Content Security Policy.
  # 'unsafe-inline' em script-src é necessário: o Consent Mode v2, o marcador .js
  # e o JSON-LD são blocos inline no <head>. Em style-src idem, por causa dos
  # 16 atributos style="" do HTML.
  # AO LIGAR O GTM, acrescentar em script-src e connect-src:
  #   https://www.googletagmanager.com https://www.google-analytics.com
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# --------------------------------------------------------------------------
# 3. Compressão
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# 4. Cache dos estáticos (o HTML fica curto para publicar mudança na hora)
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# 5. Codificação e arquivos escondidos
# --------------------------------------------------------------------------
AddDefaultCharset UTF-8

# Bloqueia arquivos que comecam com ponto (.htaccess, .git, etc)
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>
